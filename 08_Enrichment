###############################################################
# RNA-seq Transcriptomics Pipeline
# Step 8: Functional Enrichment and GSEA
#
# Includes:
#   1. GO enrichment
#   2. KEGG pathway enrichment
#   3. Reactome pathway enrichment
#   4. GSEA using the complete ranked gene list
###############################################################


###############################################################
# 1. LOAD PACKAGES
###############################################################

library(openxlsx)
library(dplyr)
library(clusterProfiler)
library(org.Hs.eg.db)
library(ReactomePA)
library(enrichplot)
library(ggplot2)


###############################################################
# 2. DEFINE INPUT / OUTPUT
###############################################################

deg_file <- paste0(
  "results/Differential_Expression/",
  "03_Wald_Test/Wald_All_Genes.xlsx"
)

output_dir <- "results/Enrichment"

dir.create(
  output_dir,
  recursive = TRUE,
  showWarnings = FALSE
)

go_dir <- file.path(
  output_dir,
  "GO"
)

kegg_dir <- file.path(
  output_dir,
  "KEGG"
)

reactome_dir <- file.path(
  output_dir,
  "Reactome"
)

gsea_dir <- file.path(
  output_dir,
  "GSEA"
)

dir.create(
  go_dir,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  kegg_dir,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  reactome_dir,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  gsea_dir,
  recursive = TRUE,
  showWarnings = FALSE
)


###############################################################
# 3. ENRICHMENT PARAMETERS
###############################################################

PADJ_CUTOFF <- 0.05

LOG2FC_CUTOFF <- 1.2


###############################################################
# 4. READ DESEQ2 RESULTS
###############################################################

deg <- read.xlsx(
  deg_file
)


###############################################################
# 5. CHECK REQUIRED COLUMNS
###############################################################

required_columns <- c(
  "Gene",
  "log2FoldChange",
  "padj",
  "stat"
)

missing_columns <- setdiff(
  required_columns,
  colnames(deg)
)

if(length(missing_columns) > 0){

  stop(
    paste(
      "Missing required columns:",
      paste(
        missing_columns,
        collapse = ", "
      )
    )
  )

}


###############################################################
# 6. REMOVE INVALID RESULTS
###############################################################

deg <- deg %>%

  filter(

    !is.na(
      Gene
    ),

    !is.na(
      log2FoldChange
    ),

    !is.na(
      padj
    )

  )


###############################################################
# 7. DEFINE SIGNIFICANT DEGs
###############################################################

deg_sig <- deg %>%

  filter(

    padj < PADJ_CUTOFF,

    abs(
      log2FoldChange
    ) >= LOG2FC_CUTOFF

  )


###############################################################
# 8. DEFINE UPREGULATED GENES
###############################################################

up_genes <- deg_sig %>%

  filter(
    log2FoldChange >=
      LOG2FC_CUTOFF
  ) %>%

  pull(
    Gene
  ) %>%

  unique()


###############################################################
# 9. DEFINE DOWNREGULATED GENES
###############################################################

down_genes <- deg_sig %>%

  filter(
    log2FoldChange <=
      -LOG2FC_CUTOFF
  ) %>%

  pull(
    Gene
  ) %>%

  unique()


###############################################################
# 10. CREATE GENE SET LIST
###############################################################

gene_sets <- list(

  All_Significant =
    unique(
      deg_sig$Gene
    ),

  Upregulated =
    up_genes,

  Downregulated =
    down_genes

)


###############################################################
# 11. MAP GENE SYMBOLS TO ENTREZ IDs
###############################################################

id_maps <- lapply(

  gene_sets,

  function(genes){

    if(
      length(genes) < 2
    ){

      return(
        NULL
      )

    }

    mapping <- tryCatch(

      bitr(

        genes,

        fromType = "SYMBOL",

        toType = "ENTREZID",

        OrgDb = org.Hs.eg.db

      ),

      error = function(e){

        message(
          "Gene mapping failed: ",
          conditionMessage(e)
        )

        NULL

      }

    )

    mapping

  }

)


###############################################################
# 12. GO ENRICHMENT FUNCTION
###############################################################

run_GO <- function(
  genes,
  gene_set_name
){

  if(
    length(genes) < 2
  ){

    return(
      NULL
    )

  }


  ego <- tryCatch(

    enrichGO(

      gene =
        genes,

      OrgDb =
        org.Hs.eg.db,

      keyType =
        "SYMBOL",

      ont =
        "ALL",

      pAdjustMethod =
        "BH",

      pvalueCutoff =
        0.05,

      qvalueCutoff =
        0.05,

      readable =
        TRUE

    ),

    error = function(e){

      message(
        "GO enrichment failed for ",
        gene_set_name,
        ": ",
        conditionMessage(e)
      )

      NULL

    }

  )


  if(
    !is.null(ego) &&
    nrow(
      as.data.frame(ego)
    ) > 0
  ){

    result_df <-
      as.data.frame(
        ego
      )


    write.xlsx(

      result_df,

      file.path(
        go_dir,
        paste0(
          "GO_",
          gene_set_name,
          ".xlsx"
        )
      ),

      overwrite = TRUE

    )


    pdf(

      file.path(
        go_dir,
        paste0(
          "GO_",
          gene_set_name,
          "_dotplot.pdf"
        )
      ),

      width = 11,

      height = 8

    )

    print(
      dotplot(
        ego,
        showCategory = 20
      )
    )

    dev.off()

  }


  return(
    ego
  )

}


###############################################################
# 13. KEGG ENRICHMENT FUNCTION
###############################################################

run_KEGG <- function(
  id_map,
  gene_set_name
){

  if(
    is.null(id_map) ||
    nrow(id_map) < 2
  ){

    return(
      NULL
    )

  }


  ekegg <- tryCatch(

    enrichKEGG(

      gene =
        unique(
          id_map$ENTREZID
        ),

      organism =
        "hsa",

      pAdjustMethod =
        "BH",

      pvalueCutoff =
        0.05,

      qvalueCutoff =
        0.05

    ),

    error = function(e){

      message(
        "KEGG enrichment failed for ",
        gene_set_name,
        ": ",
        conditionMessage(e)
      )

      NULL

    }

  )


  if(
    !is.null(ekegg) &&
    nrow(
      as.data.frame(ekegg)
    ) > 0
  ){

    result_df <-
      as.data.frame(
        ekegg
      )


    write.xlsx(

      result_df,

      file.path(
        kegg_dir,
        paste0(
          "KEGG_",
          gene_set_name,
          ".xlsx"
        )
      ),

      overwrite = TRUE

    )


    pdf(

      file.path(
        kegg_dir,
        paste0(
          "KEGG_",
          gene_set_name,
          "_dotplot.pdf"
        )
      ),

      width = 11,

      height = 8

    )

    print(
      dotplot(
        ekegg,
        showCategory = 20
      )
    )

    dev.off()

  }


  return(
    ekegg
  )

}


###############################################################
# 14. REACTOME ENRICHMENT FUNCTION
###############################################################

