###############################################################
# 15. RUN GO ENRICHMENT
###############################################################

go_results <- lapply(

  names(gene_sets),

  function(name){

    run_GO(
      gene_sets[[name]],
      name
    )

  }

)

names(go_results) <-
  names(gene_sets)


###############################################################
# 16. RUN KEGG ENRICHMENT
###############################################################

kegg_results <- lapply(

  names(gene_sets),

  function(name){

    run_KEGG(
      id_maps[[name]],
      name
    )

  }

)

names(kegg_results) <-
  names(gene_sets)


###############################################################
# 17. RUN REACTOME ENRICHMENT
###############################################################

reactome_results <- lapply(

  names(gene_sets),

  function(name){

    run_Reactome(
      id_maps[[name]],
      name
    )

  }

)

names(reactome_results) <-
  names(gene_sets)


###############################################################
# 18. ENRICHMENT SUMMARY
###############################################################

enrichment_summary <- data.frame(

  Gene_Set =
    names(gene_sets),

  Input_Genes =
    sapply(
      gene_sets,
      length
    ),

  Mapped_Entrez =
    sapply(
      id_maps,
      function(x){

        if(
          is.null(x)
        ){

          0

        } else {

          nrow(x)

        }

      }
    ),

  GO_Terms =
    sapply(
      go_results,
      function(x){

        if(
          is.null(x)
        ){

          0

        } else {

          nrow(
            as.data.frame(x)
          )

        }

      }
    ),

  KEGG_Pathways =
    sapply(
      kegg_results,
      function(x){

        if(
          is.null(x)
        ){

          0

        } else {

          nrow(
            as.data.frame(x)
          )

        }

      }
    ),

  Reactome_Pathways =
    sapply(
      reactome_results,
      function(x){

        if(
          is.null(x)
        ){

          0

        } else {

          nrow(
            as.data.frame(x)
          )

        }

      }
    )

)


write.xlsx(

  enrichment_summary,

  file.path(
    output_dir,
    "Enrichment_Summary.xlsx"
  ),

  overwrite = TRUE

)


###############################################################
# 19. GSEA — PREPARE RANKED GENE LIST
###############################################################

# IMPORTANT:
# GSEA does NOT use only significant DEGs.
#
# The complete gene list is ranked using the
# DESeq2 Wald statistic.

ranked_df <- deg %>%

  filter(
    !is.na(stat)
  ) %>%

  arrange(
    desc(stat)
  )


###############################################################
# 20. REMOVE DUPLICATE GENE SYMBOLS
###############################################################

ranked_df <- ranked_df %>%

  filter(
    !duplicated(
      Gene
    )
  )


###############################################################
# 21. CREATE RANKED STATISTIC
###############################################################

ranked_stat <-

  ranked_df$stat

names(ranked_stat) <-
  ranked_df$Gene


ranked_stat <-
  sort(
    ranked_stat,
    decreasing = TRUE
  )


###############################################################
# 22. CONVERT SYMBOLS TO ENTREZ IDs
###############################################################

ranked_mapping <- bitr(

  names(ranked_stat),

  fromType =
    "SYMBOL",

  toType =
    "ENTREZID",

  OrgDb =
    org.Hs.eg.db

)


###############################################################
# 23. CREATE ENTREZ-RANKED LIST
###############################################################

ranked_stat_entrez <-

  ranked_stat[
    ranked_mapping$SYMBOL
  ]

names(
  ranked_stat_entrez
) <-
  ranked_mapping$ENTREZID


ranked_stat_entrez <-

  ranked_stat_entrez[
    !duplicated(
      names(
        ranked_stat_entrez
      )
    )
  ]


ranked_stat_entrez <-
  sort(
    ranked_stat_entrez,
    decreasing = TRUE
  )


###############################################################
# 24. GSEA — GO
###############################################################

gsea_go <- tryCatch(

  gseGO(

    geneList =
      ranked_stat,

    OrgDb =
      org.Hs.eg.db,

    keyType =
      "SYMBOL",

    ont =
      "ALL",

    pAdjustMethod =
      "BH",

    pvalueCutoff =
      0.05,

    minGSSize =
      10,

    maxGSSize =
      500,

    eps =
      0

  ),

  error = function(e){

    message(
      "GO GSEA failed: ",
      conditionMessage(e)
    )

    NULL

  }

)


###############################################################
# 25. GSEA — KEGG
###############################################################

gsea_kegg <- tryCatch(

  gseKEGG(

    geneList =
      ranked_stat_entrez,

    organism =
      "hsa",

    pAdjustMethod =
      "BH",

    pvalueCutoff =
      0.05,

    minGSSize =
      10,

    maxGSSize =
      500,

    eps =
      0

  ),

  error = function(e){

    message(
      "KEGG GSEA failed: ",
      conditionMessage(e)
    )

    NULL

  }

)


###############################################################
# 26. GSEA — REACTOME
###############################################################

gsea_reactome <- tryCatch(

  gsePathway(

    geneList =
      ranked_stat_entrez,

    organism =
      "human",

    pAdjustMethod =
      "BH",

    pvalueCutoff =
      0.05,

    minGSSize =
      10,

    maxGSSize =
      500,

    eps =
      0

  ),

  error = function(e){

    message(
      "Reactome GSEA failed: ",
      conditionMessage(e)
    )

    NULL

  }

)


###############################################################
# 27. SAVE GSEA RESULTS
###############################################################

save_gsea <- function(
  result,
  name
){

  if(
    is.null(result)
  ){

    return(
      NULL
    )

  }


  result_df <-
    as.data.frame(
      result
    )


  if(
    nrow(result_df) == 0
  ){

    return(
      NULL
    )

  }


  write.xlsx(

    result_df,

    file.path(
      gsea_dir,
      paste0(
        "GSEA_",
        name,
        ".xlsx"
      )
    ),

    overwrite = TRUE

  )


  pdf(

    file.path(
      gsea_dir,
      paste0(
        "GSEA_",
        name,
        "_dotplot.pdf"
      )
    ),

    width = 11,

    height = 8

  )

  print(
    dotplot(
      result,
      showCategory = 20
    )
  )

  dev.off()


  return(
    nrow(result_df)
  )

}


###############################################################
# 28. SAVE ALL GSEA RESULTS
###############################################################

n_gsea_go <-
  save_gsea(
    gsea_go,
    "GO"
  )

n_gsea_kegg <-
  save_gsea(
    gsea_kegg,
    "KEGG"
  )

n_gsea_reactome <-
  save_gsea(
    gsea_reactome,
    "Reactome"
  )


###############################################################
# 29. GSEA SUMMARY
###############################################################

gsea_summary <- data.frame(

  Database = c(
    "GO",
    "KEGG",
    "Reactome"
  ),

  Significant_Gene_Sets = c(

    ifelse(
      is.null(n_gsea_go),
      0,
      n_gsea_go
    ),

    ifelse(
      is.null(n_gsea_kegg),
      0,
      n_gsea_kegg
    ),

    ifelse(
      is.null(n_gsea_reactome),
      0,
      n_gsea_reactome
    )

  )

)


write.xlsx(

  gsea_summary,

  file.path(
    gsea_dir,
    "GSEA_Summary.xlsx"
  ),

  overwrite = TRUE

)


###############################################################
# 30. FINAL SUMMARY
###############################################################

cat(
  "\n============================================\n"
)

cat(
  "FUNCTIONAL ENRICHMENT COMPLETE\n"
)

cat(
  "============================================\n"
)

cat(
  "Significant DEGs:",
  nrow(deg_sig),
  "\n"
)

cat(
  "Upregulated genes:",
  length(up_genes),
  "\n"
)

cat(
  "Downregulated genes:",
  length(down_genes),
  "\n"
)

cat(
  "GSEA ranking: DESeq2 Wald statistic\n"
)

cat(
  "GSEA input: complete gene list\n"
)

cat(
  "Output folder:",
  output_dir,
  "\n"
)

cat(
  "============================================\n"
)


